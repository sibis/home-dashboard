<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-title" content="Tasks">
  <title>Family Tasks</title>
  <style>
    * { box-sizing: border-box; }
    body { font-family: -apple-system, system-ui, sans-serif; margin: 0; padding: 16px; max-width: 480px; margin-inline: auto; color: #111; background: #fafafa; }
    h1 { font-size: 22px; margin: 4px 0 16px; }
    h2 { font-size: 13px; text-transform: uppercase; letter-spacing: .05em; color: #666; margin: 20px 0 6px; }
    form { display: grid; gap: 8px; }
    .people { display: flex; gap: 6px; }
    .people label { flex: 1; }
    .people input { position: absolute; opacity: 0; }
    .people span { display: block; text-align: center; padding: 10px 0; border: 1px solid #111; border-radius: 10px; }
    .people input:checked + span { background: #111; color: #fff; }
    .add { display: flex; gap: 8px; }
    input[type=text] { flex: 1; font-size: 16px; padding: 12px; border: 1px solid #ccc; border-radius: 10px; }
    button { font-size: 16px; padding: 12px 16px; border: 0; border-radius: 10px; background: #111; color: #fff; }
    ul { list-style: none; margin: 0; padding: 0; }
    li { display: flex; align-items: center; gap: 12px; padding: 12px; background: #fff; border: 1px solid #e5e5e5; border-radius: 10px; margin-bottom: 6px; }
    li.done .text { text-decoration: line-through; color: #999; }
    .text { flex: 1; word-break: break-word; }
    .check { width: 26px; height: 26px; padding: 0; border: 2px solid #111; border-radius: 50%; background: #fff; color: #fff; font-size: 14px; line-height: 1; }
    li.done .check { background: #111; }
    .del { background: none; color: #999; padding: 4px 8px; font-size: 20px; }
    .empty { color: #999; font-size: 14px; padding: 4px 2px; }
  </style>
</head>
<body>
  <h1>Family tasks</h1>

  <form id="add-form">
    <div class="people" id="people"></div>
    <div class="add">
      <input type="text" id="text" maxlength="80" placeholder="Add a task" autocomplete="off" required>
      <button type="submit">Add</button>
    </div>
  </form>

  <div id="lists"></div>

  <script>
    const PEOPLE = <%- JSON.stringify(people).replace(/</g, '\\u003c') %>;
    const peopleEl = document.getElementById('people');
    const listsEl = document.getElementById('lists');
    const textEl = document.getElementById('text');

    // Remember who you are on this phone (storage may be unavailable, so ignore failures)
    let me = PEOPLE[0];
    try { me = localStorage.getItem('taskPerson') || me; } catch (_) {}
    if (!PEOPLE.includes(me)) me = PEOPLE[0];

    PEOPLE.forEach(name => {
      const label = document.createElement('label');
      const input = document.createElement('input');
      input.type = 'radio'; input.name = 'owner'; input.value = name; input.checked = name === me;
      input.addEventListener('change', () => {
        me = name;
        try { localStorage.setItem('taskPerson', name); } catch (_) {}
      });
      const span = document.createElement('span');
      span.textContent = name;
      label.append(input, span);
      peopleEl.append(label);
    });

    async function api(url, options) {
      const res = await fetch(url, options);
      if (!res.ok) throw new Error((await res.json().catch(() => ({}))).error || res.statusText);
      return res.status === 204 ? null : res.json();
    }

    function render(tasks) {
      listsEl.replaceChildren();
      PEOPLE.forEach(name => {
        const mine = tasks.filter(t => t.owner === name).sort((a, b) => a.done - b.done || a.createdAt - b.createdAt);
        const h = document.createElement('h2');
        h.textContent = name;
        const ul = document.createElement('ul');
        mine.forEach(task => {
          const li = document.createElement('li');
          if (task.done) li.className = 'done';
          const check = document.createElement('button');
          check.className = 'check'; check.textContent = '✓'; check.setAttribute('aria-label', 'Toggle done');
          check.onclick = () => act(`/api/tasks/${task.id}/toggle`, { method: 'POST' });
          const text = document.createElement('span');
          text.className = 'text'; text.textContent = task.text;
          const del = document.createElement('button');
          del.className = 'del'; del.textContent = '×'; del.setAttribute('aria-label', 'Delete');
          del.onclick = () => act(`/api/tasks/${task.id}`, { method: 'DELETE' });
          li.append(check, text, del);
          ul.append(li);
        });
        listsEl.append(h);
        if (mine.length === 0) {
          const empty = document.createElement('div');
          empty.className = 'empty'; empty.textContent = 'Nothing yet';
          listsEl.append(empty);
        } else {
          listsEl.append(ul);
        }
      });
    }

    async function load() {
      try { render((await api('/api/tasks')).tasks); } catch (e) { console.warn(e); }
    }
    async function act(url, options) {
      try { await api(url, options); } catch (e) { alert(e.message); }
      load();
    }

    document.getElementById('add-form').addEventListener('submit', async e => {
      e.preventDefault();
      await act('/api/tasks', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ owner: me, text: textEl.value }),
      });
      textEl.value = '';
    });

    load();
    setInterval(load, 30000); // Pick up changes made on the other phone
  </script>
</body>
</html>
